---
import Button from "../../common/Button.astro";
import { Icon } from "astro-icon/components";
import { profile, sitePath } from "../../../data/profile";

const contactUrl = sitePath("/contact");
---

<h2 slot="title" class="about-title scroll-target-title" data-i18n-fr="Échangeons" data-i18n-en="Let’s connect">Let’s connect</h2>

<div class="about-content scroll-target-content">
  <p data-i18n-fr={profile.positioning.fr.availability} data-i18n-en={profile.positioning.en.availability}>{profile.positioning.fr.availability}</p>
  <p data-i18n-fr="Basée entre Paris et Nice, avec des racines en France et à Madagascar." data-i18n-en="Based between Paris and Nice, with roots in France and Madagascar.">
    Based between Paris and Nice, with roots in France and Madagascar.
  </p>

  <div class="contact-actions">
    {profile.contact.email && <a href={`mailto:${profile.contact.email}`}>
      <Icon name="ri:mail-line" size={20} aria-hidden="true" />
      <span>Email</span>
    </a>}
    {profile.contact.linkedin && <a href={profile.contact.linkedin} target="_blank" rel="noopener noreferrer">
      <Icon name="ri:linkedin-box-line" size={20} aria-hidden="true" />
      <span>LinkedIn</span>
    </a>}
    {profile.contact.github && <a href={profile.contact.github} target="_blank" rel="noopener noreferrer">
      <Icon name="ri:github-line" size={20} aria-hidden="true" />
      <span>GitHub</span>
    </a>}
  </div>

  <div class="button-group">
    <Button
      class="button"
      href={contactUrl}
      text="Contact & availability"
      data-i18n-fr="Contact & disponibilités"
      data-i18n-en="Contact & availability"
      wrapperClass="cta-link"
    />
  </div>
</div>

<style>
  p {
    margin-bottom: 1.5rem;
    line-height: 1.7;
    color: var(--theme-text);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }

  .contact-actions a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--button-border-color);
    border-radius: 6px;
    color: var(--text-muted);
    text-decoration: none;
    font-family: var(--font-family-sans);
    font-size: 0.82rem;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .contact-actions a:hover,
  .contact-actions a:focus-visible {
    color: var(--text-color);
    border-color: var(--button-border-hover-color);
    background: var(--button-hover-bg);
    text-decoration: none;
  }

  .button-group {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
  }
</style>
