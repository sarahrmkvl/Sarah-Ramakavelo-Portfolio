---
// Content for the "Meet me!" section
import Button from "../../common/Button.astro";
import { languageAttributes, profile, sitePath } from "../../../data/profile";

const resumeUrl = sitePath("/resume");
// const contactUrl = "/contact";
---

<h2 slot="title" class="about-title scroll-target-title">Markets, with perspective</h2>

<div class="about-content scroll-target-content">
  <p {...languageAttributes({ fr: profile.positioning.fr.summary, en: profile.positioning.en.summary })}>{profile.positioning.fr.summary}</p>

  <div class="highlights">
    {profile.highlights.map((highlight) => (
      <div class="highlight"><strong>{highlight.value}</strong><span {...languageAttributes(highlight.label)}>{highlight.label.fr}</span></div>
    ))}
  </div>

  <p {...languageAttributes({ fr: profile.positioning.fr.availability, en: profile.positioning.en.availability })}>{profile.positioning.fr.availability}</p>

  <div class="button-group">
    <Button
      class="button"
      href={resumeUrl}
      text="View My Résumé"
      wrapperClass="meet-me-cta-button"
    />
  </div>
</div>

<style>
  .button-group {
    display: flex;
    gap: 1rem; /* Adjust spacing as needed */
    margin-top: 2rem;
  }
  .highlights { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 1rem; margin: 2rem 0; }
  .highlight { display: flex; flex-direction: column; gap: .25rem; }
  .highlight strong { font-size: 1.6rem; }
  .highlight span { font-family: var(--font-family-sans); font-size: .8rem; color: var(--text-muted); }
</style>
