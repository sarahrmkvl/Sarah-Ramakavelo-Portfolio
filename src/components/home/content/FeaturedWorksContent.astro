---
import {
  allProjectsData,
  type ProjectDataItem,
} from "../../../data/projectsData";
import FeaturedProjectCard from "../FeaturedProjectCard.astro"; // Import the new card component
import Button from "../../common/Button.astro";
import { sitePath } from "../../../data/profile";

const featuredProjects: ProjectDataItem[] = allProjectsData.filter(
  (project) => project.isFeatured
);
const projectsUrl = sitePath("/projects");

---

<h2 slot="title" class="about-title scroll-target-title">Selected analysis</h2>

<div class="about-content scroll-target-content featured-works-container">
  {
    featuredProjects.map((project) => {
      return (
        <FeaturedProjectCard
          title={project.title}
          titleFr={project.titleFr}
          homepageSummary={project.homepageSummary}
          homepageSummaryFr={project.homepageSummaryFr}
          imageAlt={project.imageAlt}
          githubUrl={project.githubUrl}
          slug={project.id}
        />
      );
    })
  }

  <div class="button-group">
    <Button
      class="button"
      href={projectsUrl}
      text="Explore all projects"
      wrapperClass="projects-cta-button"
    />
  </div>
</div>

<style>
  .featured-works-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 696px) {
    .featured-works-container {
      width: 100%;
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .button-group {
    display: flex;
    gap: 1rem;
  }
</style>
