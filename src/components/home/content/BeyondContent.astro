---
import { languageAttributes, profile } from "../../../data/profile";

const { story } = profile;
---

<div slot="title" class="beyond-heading scroll-target-title">
  <p class="eyebrow" {...languageAttributes({ fr: story.fr.eyebrow, en: story.en.eyebrow })}>{story.fr.eyebrow}</p>
  <h2 class="about-title" {...languageAttributes({ fr: story.fr.title, en: story.en.title })}>{story.fr.title}</h2>
  <p class="subtitle" {...languageAttributes({ fr: story.fr.subtitle, en: story.en.subtitle })}>{story.fr.subtitle}</p>
</div>

<div class="story-grid scroll-target-content">
  {story.cards.map((card, index) => (
    <article class:list={["story-card", `theme-${card.theme}`, { featured: index === 0 || index === 2 }]}>
      <div class="card-topline">
        <span class="card-icon" aria-hidden="true">{card.icon}</span>
        <span class="card-kicker" {...languageAttributes(card.kicker)}>{card.kicker.fr}</span>
      </div>
      <h3 {...languageAttributes(card.title)}>{card.title.fr}</h3>
      <p {...languageAttributes(card.text)}>{card.text.fr}</p>
    </article>
  ))}
</div>

<style>
  .beyond-heading .eyebrow {
    margin: 0 0 0.75rem;
    font-family: var(--font-family-sans);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0;
    color: var(--text-muted);
  }

  .beyond-heading .about-title {
    margin-top: 0;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    max-width: 52ch;
    margin: 0 0 2.5rem;
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .story-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
    width: 100%;
  }

  .story-card {
    --story-accent: #667b79;
    min-height: 10rem;
    padding: 1.25rem;
    box-sizing: border-box;
    border: 1px solid color-mix(in srgb, var(--story-accent) 52%, var(--card-border-color));
    border-radius: 8px;
    background: color-mix(in srgb, var(--story-accent) 9%, transparent);
  }

  .card-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .card-icon {
    font-family: var(--font-family-sans);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--story-accent);
  }

  .card-kicker {
    font-family: var(--font-family-sans);
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    text-align: right;
    color: var(--text-muted);
  }

  .story-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .story-card p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .theme-clay { --story-accent: #a44938; }
  .theme-sea { --story-accent: #277d88; }
  .theme-sport { --story-accent: #44713f; }
  .theme-alpine { --story-accent: #52709a; }
  .theme-ink { --story-accent: #6b657d; }
  .theme-podium { --story-accent: #a27d28; }
  .theme-voice { --story-accent: #96587a; }
  .theme-travel { --story-accent: #46756a; }

  @media (min-width: 720px) {
    .story-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .story-card.featured {
      grid-column: span 2;
    }
  }

  @media (max-width: 420px) {
    .story-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
