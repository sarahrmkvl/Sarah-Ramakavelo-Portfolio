---
import SubPageLayout from "../layouts/SubPageLayout.astro";
import ProjectCard from "../components/projects/ProjectCard.astro";
import { allProjectsData } from "../data/projectsData";
import { sitePath } from "../data/profile";

const projects = allProjectsData;

---

<SubPageLayout title="Projects">
  <p class="page-intro">
    Applied finance and data projects exploring portfolio construction, risk
    and operational controls.
  </p>
  <div class="projects-grid">
    {
      projects.map((project) => {
        return (
          <ProjectCard
            id={project.id}
            detailUrl={sitePath(`/projects/${project.id}`)}
            title={project.title}
            titleFr={project.titleFr}
            timeframe={project.timeframe}
            timeframeFr={project.timeframeFr}
            imageSrc={project.imageSrc}
            imageAlt={project.imageAlt}
            githubUrl={project.githubUrl}
            projectUrl={project.projectUrl}
            githubRepos={project.githubRepos}
            techStack={project.techStack}
          >
            <div
              data-i18n-html-fr={project.descriptionFr ?? project.description}
              data-i18n-html-en={project.description}
              set:html={project.descriptionFr ?? project.description}
            />
          </ProjectCard>
        );
      })
    }
  </div>
</SubPageLayout>


<style>
  .page-intro {
    font-size: 1.2rem;
    color: var(--text-muted);
    margin-bottom: 3rem;
    max-width: 70ch;
  }
  .projects-grid {
    column-count: 1;
    column-gap: 3rem;
    gap: 3rem;
  }

  @media (min-width: 1024px) {
    .projects-grid {
      column-count: 2;
      column-gap: 3rem;
      gap: 3rem;
    }
  }

  .projects-grid > :global(.project-card) {
    break-inside: avoid;
  }
</style>
