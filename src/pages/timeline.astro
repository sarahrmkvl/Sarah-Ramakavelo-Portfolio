---
import SubPageLayout from "../layouts/SubPageLayout.astro";
import { allTimelineEvents } from "../data/timelineEvents";
import "../styles/timeline.css";
---

<SubPageLayout title="Parcours" backgroundTheme="yellow" backgroundScene="timeline">
  <p class="intro" data-i18n-fr="Expériences professionnelles et formation, de la plus récente à la plus ancienne." data-i18n-en="Professional experience and education, from most recent to earliest.">Expériences professionnelles et formation, de la plus récente à la plus ancienne.</p>
  <ul class="timeline-container">
    {allTimelineEvents.map((event, index) => <li class:list={["timeline-event", { "is-last": index === allTimelineEvents.length - 1 }]} data-category={event.category.toLowerCase()}>
      <div class="timeline-marker"></div>
      <div class="timeline-content">
        <div class="timeline-header">
          <span class="timeline-date" data-i18n-fr={event.dateRange} data-i18n-en={event.dateRangeEn}>{event.dateRange}</span>
          <h3 class="timeline-title" data-i18n-fr={event.title} data-i18n-en={event.titleEn}>{event.title}</h3>
        </div>
        <div class="timeline-description" data-i18n-html-fr={event.description} data-i18n-html-en={event.descriptionEn} set:html={event.description} />
      </div>
    </li>)}
  </ul>
</SubPageLayout>

<style>.intro{max-width:65ch;margin:0 0 3rem;color:var(--text-muted)}</style>

<script>
  const animateMobileTimelineNodes = () => {
    if (window.innerWidth > 800 || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const origin = { x: window.innerWidth * 0.72, y: window.innerHeight * 0.42 };
    const markers = document.querySelectorAll<HTMLElement>(".timeline-marker:not([data-arrived])");
    markers.forEach((marker, index) => {
      marker.dataset.arrived = "true";
      const bounds = marker.getBoundingClientRect();
      const destination = {
        x: bounds.left + bounds.width / 2,
        y: bounds.top + bounds.height / 2,
      };
      marker.animate(
        [
          {
            translate: `${origin.x - destination.x}px ${origin.y - destination.y}px`,
            scale: "0.65",
            opacity: 0,
          },
          { translate: "0 0", scale: "1", opacity: 1 },
        ],
        {
          duration: 850,
          delay: index * 90,
          easing: "cubic-bezier(0.22, 1, 0.36, 1)",
          fill: "both",
        }
      );
    });
  };

  document.addEventListener("astro:page-load", animateMobileTimelineNodes);
  requestAnimationFrame(animateMobileTimelineNodes);
</script>
