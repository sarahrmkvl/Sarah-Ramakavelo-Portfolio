---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/home/Hero.astro";
import SectionWrapper from "../components/home/SectionWrapper.astro";
import AboutMeContent from "../components/home/content/AboutMeContent.astro";
import FeaturedWorksContent from "../components/home/content/FeaturedWorksContent.astro";
import HighlightsUpdatesContent from "../components/home/content/HighlightsUpdatesContent.astro";
import ConnectContent from "../components/home/content/ConnectContent.astro";
import BeyondContent from "../components/home/content/BeyondContent.astro";
import EducationContent from "../components/home/content/EducationContent.astro";
---

<Layout title="Homepage">
  <main class="homepage-content">
    <Hero />

    <SectionWrapper id="about" backgroundTheme="green" backgroundScene="network">
      <AboutMeContent />
    </SectionWrapper>

    <SectionWrapper id="education" backgroundTheme="white" backgroundScene="education">
      <EducationContent />
    </SectionWrapper>

    <SectionWrapper id="work" backgroundTheme="blue" backgroundScene="projects">
      <FeaturedWorksContent />
    </SectionWrapper>

    <SectionWrapper id="journey" backgroundTheme="yellow" backgroundScene="experience">
      <HighlightsUpdatesContent />
    </SectionWrapper>

    <SectionWrapper id="beyond" backgroundTheme="ochre" backgroundScene="beyond">
      <BeyondContent />
    </SectionWrapper>

    <SectionWrapper id="contact" backgroundTheme="purple" backgroundScene="contact">
      <ConnectContent />
    </SectionWrapper>
  </main>
</Layout>

<style>
  .homepage-content {
    display: flex;
    flex-direction: column;
  }
  main {
    position: relative;
    width: 100%;
  }
</style>
