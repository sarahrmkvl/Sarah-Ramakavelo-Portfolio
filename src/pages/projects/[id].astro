---
import { Icon } from "astro-icon/components";
import SubPageLayout from "../../layouts/SubPageLayout.astro";
import { projects, type Project } from "../../data/projects";
import { languageAttributes, sitePath } from "../../data/profile";

export function getStaticPaths() {
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

interface Props { project: Project }
const { project } = Astro.props;
const label = (fr: string, en: string) => ({ "data-i18n-fr": fr, "data-i18n-en": en });
---

<SubPageLayout title={project.name.fr} titleEn={project.name.en}>
  <article class="case-study">
    <header class="case-intro">
      <p class="eyebrow" {...languageAttributes(project.timeframe)}>{project.timeframe.fr}</p>
      <p class="summary" {...languageAttributes(project.summary)}>{project.summary.fr}</p>
      {project.confidentiality && <p class="confidentiality" {...languageAttributes(project.confidentiality)}>{project.confidentiality.fr}</p>}
      <div class="technologies">{project.technologies.map((technology) => <span>{technology}</span>)}</div>
      <div class="project-actions">
        {project.links.github && <a href={project.links.github} target="_blank" rel="noopener noreferrer"><Icon name="ri:github-line" /><span {...label("Voir le dépôt", "View repository")}>Voir le dépôt</span></a>}
        {project.links.live && <a href={project.links.live} target="_blank" rel="noopener noreferrer"><Icon name="ri:external-link-line" /><span {...label("Voir le projet", "View live project")}>Voir le projet</span></a>}
      </div>
    </header>

    {project.images.length > 0 && <section class="gallery" aria-label="Galerie du projet">
      {project.images.map((image, index) => <figure class:list={{ wide: index === 0 }}>
        <img src={sitePath(image.src)} alt={image.alt.fr} loading={index === 0 ? "eager" : "lazy"} />
        {image.caption && <figcaption {...languageAttributes(image.caption)}>{image.caption.fr}</figcaption>}
      </figure>)}
    </section>}

    <div class="case-sections">
      <section><h2 {...label("Contexte", "Context")}>Contexte</h2><p {...languageAttributes(project.context)}>{project.context.fr}</p></section>
      <section><h2 {...label("Problématique", "Problem")}>Problématique</h2><p {...languageAttributes(project.problem)}>{project.problem.fr}</p></section>
      <section><h2 {...label("Méthode", "Method")}>Méthode</h2><ol>{project.method.fr.map((item, index) => <li data-i18n-fr={item} data-i18n-en={project.method.en[index] ?? item}>{item}</li>)}</ol></section>
      <section><h2 {...label("Résultats", "Results")}>Résultats</h2><ul>{project.results.fr.map((item, index) => <li data-i18n-fr={item} data-i18n-en={project.results.en[index] ?? item}>{item}</li>)}</ul></section>
      <section><h2 {...label("Ce que j’en retiens", "Key learnings")}>Ce que j’en retiens</h2><p {...languageAttributes(project.learnings)}>{project.learnings.fr}</p></section>
    </div>

    <a class="back-to-projects" href={sitePath("/projects")}><Icon name="ri:arrow-left-line" /><span {...label("Tous les projets", "All projects")}>Tous les projets</span></a>
  </article>
</SubPageLayout>

<style>
  .case-study { max-width: 1040px; }
  .case-intro { max-width: 760px; margin-bottom: 4rem; }
  .eyebrow, .confidentiality { font-family:var(--font-family-sans); font-size:.78rem; color:var(--text-muted); }
  .summary { font-size:clamp(1.3rem,1.1rem + .8vw,1.8rem); line-height:1.55; }
  .confidentiality { padding-left:.75rem; border-left:2px solid var(--card-border-color); }
  .technologies { display:flex; flex-wrap:wrap; gap:.5rem; margin:1.5rem 0; }
  .technologies span { padding:.3rem .55rem; border:1px solid var(--card-border-color); border-radius:5px; font-family:var(--font-family-sans); font-size:.72rem; }
  .project-actions { display:flex; flex-wrap:wrap; gap:1.25rem; }
  .project-actions a, .back-to-projects { display:inline-flex; align-items:center; gap:.45rem; font-family:var(--font-family-sans); font-size:.85rem; text-decoration:none; }
  .gallery { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; margin:0 0 5rem; }
  figure { margin:0; }
  figure.wide { grid-column:1 / -1; }
  img { width:100%; height:auto; max-height:680px; object-fit:contain; display:block; border:1px solid var(--card-border-color); border-radius:8px; background:var(--bg-color); }
  figcaption { margin-top:.5rem; font-family:var(--font-family-sans); font-size:.75rem; color:var(--text-muted); }
  .case-sections section { display:grid; grid-template-columns:minmax(130px,.35fr) minmax(0,1fr); gap:2rem; padding:2.5rem 0; border-top:1px solid var(--card-border-color); }
  .case-sections section:last-child { border-bottom:1px solid var(--card-border-color); }
  h2 { margin:0; font-size:1.2rem; }
  .case-sections p, .case-sections li { margin-top:0; font-size:1.08rem; line-height:1.75; }
  .case-sections ol, .case-sections ul { margin:0; padding-left:1.4rem; }
  .back-to-projects { margin-top:3rem; }
  @media(max-width:680px){ .gallery,.case-sections section{grid-template-columns:1fr}.gallery figure{grid-column:auto}.case-sections section{gap:1rem} }
</style>
