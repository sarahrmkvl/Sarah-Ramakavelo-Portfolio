---
import SubPageLayout from "../layouts/SubPageLayout.astro";
import { Icon } from "astro-icon/components";
import { profile } from "../data/profile";
---

<SubPageLayout title="Contact" backgroundTheme="purple" backgroundScene="contact">
  <div class="contact-content">
    <p class="intro-text" data-i18n-fr={profile.positioning.fr.availability} data-i18n-en={profile.positioning.en.availability}>{profile.positioning.fr.availability}</p>
    <p class="intro-text">{profile.identity.basedIn.join(" · ")}</p>

    <h3 class="contact-section-title" data-i18n-fr="Coordonnées" data-i18n-en="Contact information">Coordonnées</h3>
    {!profile.contact.email && !profile.contact.linkedin && <p class="section-description" data-i18n-fr="Les coordonnées professionnelles seront ajoutées prochainement." data-i18n-en="Professional contact details will be added soon.">Les coordonnées professionnelles seront ajoutées prochainement.</p>}
    <div class="contact-actions">
      {profile.contact.email && <a href={`mailto:${profile.contact.email}`}><Icon name="ri:mail-line" /><span><strong>Email</strong><small>{profile.contact.email}</small></span></a>}
      {profile.contact.linkedin && <a href={profile.contact.linkedin} target="_blank" rel="noopener noreferrer"><Icon name="ri:linkedin-box-line" /><span><strong>LinkedIn</strong><small data-i18n-fr="Voir le profil" data-i18n-en="View profile">Voir le profil</small></span></a>}
      {profile.contact.github && <a href={profile.contact.github} target="_blank" rel="noopener noreferrer"><Icon name="ri:github-line" /><span><strong>GitHub</strong><small data-i18n-fr="Voir le profil" data-i18n-en="View profile">Voir le profil</small></span></a>}
    </div>
  </div>
</SubPageLayout>

<style>
  .contact-content {
    max-width: 600px;
  }

  .intro-text {
    margin-bottom: 1rem;
    font-size: 1.2em;
    line-height: 1.7;
    color: var(--text-muted);
  }

  .contact-section-title {
    font-size: 1.4rem;
    font-weight: 600;
    margin-top: 3rem;
    margin-bottom: 0.5rem;
    color: var(--text-heading-color);
  }

  .section-description {
    font-size: 1.2rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  .contact-actions {
    display: grid;
    gap: 0.75rem;
  }
  .contact-actions a {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    border: 1px solid var(--button-border-color);
    border-radius: 7px;
    color: var(--link-color);
    text-decoration: none;
    font-family: var(--font-family-sans);
    transition: color .2s ease, border-color .2s ease, background-color .2s ease;
  }
  .contact-actions a:hover {
    color: var(--link-hover-color);
    border-color: var(--button-border-hover-color);
    background: var(--button-hover-bg);
    text-decoration: none;
  }
  .contact-actions :global(svg) { flex: 0 0 auto; font-size: 1.3rem; }
  .contact-actions span { min-width: 0; display: flex; flex-direction: column; gap: .15rem; }
  .contact-actions small { overflow-wrap: anywhere; color: var(--text-muted); }
  .contact-actions strong { font-size: .9rem; }

  .section-divider {
    border: 0;
    height: 1px;
    background: var(--button-border-color);
    margin: 3rem 0;
  }
</style>
